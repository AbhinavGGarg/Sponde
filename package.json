{
  "name": "sponde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The room where two people's agents meet, negotiate, and commit to nothing until both humans approve. Built on the TrueForge agent harness.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "server": "tsx src/server/main.ts",
    "seed-agents": "tsx src/scripts/seed-agents.ts",
    "negotiate": "tsx src/scripts/negotiate.ts",
    "rehearse": "tsx src/scripts/rehearse.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "tsx src/scripts/doctor.ts",
    "ui": "npm --prefix ui run dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "@types/nodemailer": "^8.0.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "nodemailer": "^9.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
